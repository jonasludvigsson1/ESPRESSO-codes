  "notes": [
    {
      "note_id": "T0",
      "type": "source",
      "text": "Definition agreed in discussion with Juan Vaz and Fahim Ebrahimi, 2026-11-18."
    },
    {
      "note_id": "T1",
      "type": "source",
      "text": "There is no ICD-7 or ICD-8 code for liver transplantation."
    },
    {
      "note_id": "T2",
      "type": "curator",
      "text": "The classification system of the procedure codes 5200, JJC, DJ005 and DJ006 is not stated in the source document; confirm it (for example Swedish operation/KVÅ codes) before use."
    },
    {
      "note_id": "T3",
      "type": "curator",
      "text": "ICD-9 V42H and ICD-10 Z94.4 describe transplant status and T86.4 describes transplant failure and rejection, so these can be recorded after the transplantation date. The procedure codes are the more reliable marker of the date."
    }
  ]

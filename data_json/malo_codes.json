      "role": "outcome | not_included",
      "variant": "main | optional",
      "register": "Register in which the code is searched",
      "icd_version": "7, 8, 9, 10 | procedure | reference (points to another code list)",
      "code_or_range": "Code as written for that ICD version (ICD-7/8 use a decimal comma; ICD-9/10 use dots in the international format)",
      "label": "Short description of the code, where the source gave one",
      "note_ids": "Semicolon-separated ids of entries in \"notes\" (type \"source\" = comment in the source document; \"curator\" = added during curation)"
    }
  },
